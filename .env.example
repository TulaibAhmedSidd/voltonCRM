# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas (free M0) — Atlas → Connect → Drivers → copy the mongodb+srv:// string
MONGODB_URI=

# "true" shows the /dev/ui component catalog on a Vercel deployment (always on in development)
ENABLE_UI_CATALOG=false

# Auth (M1): long random string — node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# One-time key that lets the owner create the first admin account (M1)
MASTER_KEY=

# Cloudinary (free plan) — private uploads: screenshots, site photos, documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cron (cron-job.org calls /api/cron/tick and /api/cron/sheet-pull every minute with: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# WhatsApp Cloud API (Meta developer app → WhatsApp → API setup). Webhook URL: https://<your-app>/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Meta Lead Ads (Facebook / Instagram instant forms) → CRM directly, no Google Sheet. See docs/meta-leads-setup.md
# Webhook URL: https://<your-app>/api/webhooks/meta-leads  (field: leadgen)
META_PAGE_ID=
# System-user token with leads_retrieval, pages_show_list, pages_read_engagement, pages_manage_metadata, pages_manage_ads, ads_management
META_PAGE_ACCESS_TOKEN=
# Leave empty to use WHATSAPP_APP_SECRET / WHATSAPP_VERIFY_TOKEN (same Meta app)
META_APP_SECRET=
META_VERIFY_TOKEN=

# WhatsApp Coexistence ("Connect WhatsApp number" in Settings). See docs/whatsapp-coexistence.md
# App ID (App settings → Basic) and the Facebook Login for Business configuration ID (WhatsApp Embedded Signup)
META_APP_ID=
META_ES_CONFIG_ID=

# Phone / PC notifications (Web Push). Generate once: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:voltonsolarenergy@gmail.com
